# Backend
PORT=3000
NODE_ENV=development

# Postgres
PGHOST=localhost
PGPORT=5434
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=enterprise_skills

# Redis
REDIS_URL=redis://localhost:6379

# Feature Flags / Admin
ADMIN_TOKEN=changeme
REQUIRE_AUTH=false
API_KEYS=

# Public URLs (EC2 / Docker — replace YOUR_EC2_PUBLIC_IP)
PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP:3000
PUBLIC_UI_URL=http://YOUR_EC2_PUBLIC_IP:3001
API_PORT=3000

# ── Plane CE PM Bridge (optional — branch: feature/plane-pm-integration) ──
# See docs/plane-integration.md and scripts/plane-setup.sh
PLANE_API_URL=http://plane-proxy:80
PLANE_API_TOKEN=
PLANE_WORKSPACE_SLUG=claude-skills
PLANE_WEBHOOK_SECRET=
# IP/CIDR allowlist for /webhooks/plane (comma-separated). Empty = allow all (dev default).
# Production example: PLANE_WEBHOOK_ALLOWED_IPS=54.167.31.169,172.18.0.0/16
PLANE_WEBHOOK_ALLOWED_IPS=
PLANE_SECRET_KEY=please-change-me-plane-secret-key-256
PLANE_ADMIN_EMAIL=admin@planepmsystem.local
PLANE_ADMIN_PASSWORD=Plane@Admin2026

# ── GitHub integration (branch: feature/platform-github-slack) ──────────────
# PAT (classic: ghp_... or fine-grained: github_pat_...) with repo scope
# Required for live connector test and GitHub issue/PR sync
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=your-org/your-repo
# Secret used to verify incoming GitHub webhook payloads (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=

# ── GitHub Poller (branch: feature/github-poller) ───────────────────────────
# Interim polling mechanism — replaces real-time webhook when admin access
# is unavailable. Set GITHUB_POLL_ENABLED=true to activate.
# Set back to false when a real GitHub repo webhook is registered.
GITHUB_POLL_ENABLED=false
GITHUB_POLL_INTERVAL_SEC=120

# ── Slack integration (branch: feature/platform-github-slack) ───────────────
# Bot User OAuth Token from Slack App → OAuth & Permissions (starts with xoxb-)
SLACK_BOT_TOKEN=
# Signing secret from Slack App → Basic Information → App Credentials
SLACK_SIGNING_SECRET=
# Default channel ID (C...) for platform notifications (e.g. #server-alerts)
SLACK_DEFAULT_CHANNEL=

# ── Zapier MCP integration (branch: feature/jun25-agency-sprint) ─────────────
# Connect agents to 9,000+ apps (Asana, Monday, Gmail, HubSpot, etc.)
# Setup: https://mcp.zapier.com → New MCP Server → select "Other" → generate token
# Endpoint: https://mcp.zapier.com/api/v1/connect (Streamable HTTP / JSON-RPC 2.0)
ZAPIER_MCP_ENABLED=false
ZAPIER_MCP_TOKEN=
ZAPIER_MCP_ENDPOINT=https://mcp.zapier.com/api/v1/connect
